# Copy to .env and fill in (docker compose reads .env automatically).

# Bearer token the service requires. pi workers set the same token in their
# OpenVikingProvider config so shared durable memory is private.
# Generate one, e.g. `openssl rand -hex 32`.
OPENVIKING_TOKEN=change-me

# Postgres credentials (the compose file creates this database + user).
POSTGRES_USER=openviking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openviking

# Host port the service is published on.
OPENVIKING_PORT=8080

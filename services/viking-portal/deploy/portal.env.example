# Keep the populated file mode 0600 outside the repository.
VIKING_ORIGIN=https://viking.metabolomics.us
VIKING_PORT=8091
VIKING_COGNITO_ISSUER=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_GjtcM0PCp
VIKING_COGNITO_DOMAIN=https://us-west-2gjtcm0pcp.auth.us-west-2.amazoncognito.com
# Dedicated app client from cognito-client.json; never the scheduler client.
VIKING_COGNITO_CLIENT_ID=
VIKING_COGNITO_CLIENT_SECRET_FILE=/etc/viking-portal/cognito-secret
VIKING_DATABASE_URL_FILE=/etc/viking-portal/database-url
VIKING_UPSTREAM_URL=http://127.0.0.1:1933
VIKING_UPSTREAM_ROOT_KEY_FILE=/etc/viking-portal/upstream-root-key
# Optional legacy compatibility: read only the token, not the entire old .env.
VIKING_LEGACY_URL=http://127.0.0.1:8090
VIKING_LEGACY_TOKEN_FILE=/etc/viking-portal/legacy-token

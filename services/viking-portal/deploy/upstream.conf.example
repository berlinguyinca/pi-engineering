{
  "server": {
    "host": "127.0.0.1",
    "port": 1933,
    "auth_mode": "trusted",
    "root_api_key": "REPLACE_WITH_RANDOM_SERVER_ONLY_SECRET",
    "cors_origins": []
  },
  "storage": {
    "workspace": "/data",
    "vectordb": {"name": "context", "backend": "local"},
    "agfs": {"backend": "local"}
  },
  "embedding": {
    "dense": {
      "provider": "ollama",
      "model": "nomic-embed-text",
      "api_base": "http://127.0.0.1:11434/v1",
      "dimension": 768,
      "input": "text"
    }
  },
  "vlm": {
    "provider": "ollama",
    "model": "qwen2.5:0.5b",
    "api_base": "http://127.0.0.1:11434/v1",
    "api_key": "ollama"
  }
}

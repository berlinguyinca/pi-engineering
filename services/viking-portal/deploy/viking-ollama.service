[Unit]
Description=Local CPU models for Viking memory processing
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=viking-ollama
Group=viking-ollama
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/viking-ollama/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=2
Environment=OLLAMA_KEEP_ALIVE=15m
ExecStart=/opt/viking-ollama/bin/ollama serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/viking-ollama
UMask=0077

[Install]
WantedBy=multi-user.target

{
  "name": "pi-engineering-runtime",
  "version": "0.2.0",
  "description": "Autonomous engineering runtime for the pi coding agent: Engineering Ledger, fresh-context workers, isolated candidates, deterministic verification, and independent review.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "engineering", "orchestration", "ledger", "agent"],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "npm run typecheck:core && npm run typecheck:scripts",
    "typecheck:core": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --test --import ./test/support/isolatedState.ts \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:unit": "node --test --import ./test/support/isolatedState.ts \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --import ./test/support/isolatedState.ts \"test/integration/**/*.test.ts\"",
    "test:mission-reliability": "node --test --import ./test/support/isolatedState.ts test/integration/mission-reliability-foundation.test.ts",
    "test:e2e": "node scripts/smoke-commands.ts && node scripts/smoke-load.ts",
    "bench:planner-worker": "node scripts/planner-worker-benchmark.ts",
    "test:platform": "node --test --import ./test/support/isolatedState.ts \"test/unit/platform-*.test.ts\" \"test/integration/platform-*.test.ts\"",
    "platform:e2e": "node --experimental-strip-types scripts/platform-e2e.ts",
    "platform:serve": "node --experimental-strip-types scripts/control-server.ts",
    "test:roadmap": "node --test --import ./test/support/isolatedState.ts \"test/unit/roadmap*.test.ts\" \"test/integration/roadmap*.test.ts\"",
    "test:dogfood:lifecycle": "node scripts/dogfood-lifecycle.ts",
    "dogfood:mission-recovery": "node scripts/dogfood-mission-recovery.ts --model local/local",
    "roadmap:check": "node scripts/pi-engineering.ts roadmap check",
    "roadmap:status": "node scripts/pi-engineering.ts roadmap status",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "npm run typecheck"
  },
  "bin": {
    "pi-engineering": "./scripts/pi-engineering.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "typebox": "*",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": ["./src/runtime/host/entry.ts"]
  },
  "piEngineering": {
    "runtimeApi": 1,
    "entry": "src/runtime/host/runtimeEntry.ts",
    "minimumPiVersion": "0.87.0",
    "maximumPiVersion": "0.x",
    "stateSchema": { "minReadable": 1, "maxReadable": 1, "writes": 1 }
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.0"
  }
}

{
  "name": "pi-engineering-runtime",
  "version": "0.2.0",
  "description": "Autonomous engineering runtime for the pi coding agent: Engineering Ledger, fresh-context workers, isolated candidates, deterministic verification, and independent review.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "engineering", "orchestration", "ledger", "agent"],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test \"test/integration/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.10.0",
    "typebox": "*",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": ["./extensions"]
  }
}

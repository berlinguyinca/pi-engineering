{
  "name": "pi-engineering-runtime",
  "version": "0.2.0",
  "description": "Autonomous engineering runtime for the pi coding agent: Engineering Ledger, fresh-context workers, isolated candidates, deterministic verification, and independent review.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "engineering", "orchestration", "ledger", "agent"],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test \"test/integration/**/*.test.ts\"",
    "test:e2e": "node scripts/smoke-commands.ts && node scripts/smoke-load.ts",
    "test:platform": "node --test \"test/unit/platform-*.test.ts\" \"test/integration/platform-*.test.ts\"",
    "platform:e2e": "node --experimental-strip-types scripts/platform-e2e.ts",
    "platform:serve": "node --experimental-strip-types scripts/control-server.ts",
    "test:roadmap": "node --test \"test/unit/roadmap*.test.ts\" \"test/integration/roadmap*.test.ts\"",
    "roadmap:check": "node scripts/pi-engineering.ts roadmap check",
    "roadmap:status": "node scripts/pi-engineering.ts roadmap status",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "tsc --noEmit"
  },
  "bin": {
    "pi-engineering": "./scripts/pi-engineering.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typebox": "*",
    "typescript": "^5.6.0",
    "yaml": "^2.9.0"
  },
  "pi": {
    "extensions": ["./extensions"]
  }
}

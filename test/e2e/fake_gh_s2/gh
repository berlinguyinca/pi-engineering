#!/usr/bin/env node
// FAKE - test shim. NOT the GitHub CLI. Used only by test/e2e/s2-autospec-mission.e2e.test.ts.
// Answers the few `gh api` calls Pi's GhCliClient makes (issues/N, pulls/N, POST pulls) from state.json beside this file.
// The PR head SHA is read from a REAL bare git remote, so a real repair commit pushed there really moves the head.
import { execFileSync } from "node:child_process";
import { appendFileSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const statePath = join(here, "state.json");
const state = JSON.parse(readFileSync(statePath, "utf8"));
const argv = process.argv.slice(2);
appendFileSync(join(here, "calls.jsonl"), `${JSON.stringify(argv)}\n`);
const fail = (msg, code = 1) => {
  process.stderr.write(`${msg}\n`);
  process.exit(code);
};
if (argv[0] !== "api") fail("fake gh: only `gh api` is implemented");
const path = argv[argv.length - 1];
const post = argv.includes("POST");
const fields = {};
for (let i = 0; i < argv.length; i++) if (argv[i] === "-f" || argv[i] === "-F") {
  const [k, ...v] = argv[i + 1].split("=");
  fields[k] = v.join("=");
}
const head = (branch) => execFileSync("git", ["--git-dir", state.remote, "rev-parse", `refs/heads/${branch}`], { encoding: "utf8" }).trim();
const prJson = (n, pr) => ({
  number: n, title: pr.title, body: "", state: "open", html_url: `https://github.com/${state.repo}/pull/${n}`,
  user: { login: state.author }, head: { ref: pr.branch, sha: head(pr.branch), repo: { full_name: state.repo } }, base: { ref: "main" },
});
let m;
if (post && (m = path.match(/^repos\/([^/]+\/[^/]+)\/pulls$/))) {
  if (m[1] !== state.repo) fail("Not Found (HTTP 404)");
  const n = state.nextPr++;
  state.prs[n] = { title: fields.title ?? "pr", branch: fields.head };
  writeFileSync(statePath, JSON.stringify(state));
  process.stdout.write(JSON.stringify(prJson(n, state.prs[n])));
} else if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/commits\/([0-9a-f]+)\/check-runs$/))) {
  const runs = m[1] === state.repo ? (state.checks?.[m[2]] ?? []) : [];
  const page = { total_count: runs.length, check_runs: runs.map((r) => ({ head_sha: m[2], status: "completed", ...r })) };
  process.stdout.write(JSON.stringify(argv.includes("--slurp") ? [page] : page));
} else if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/pulls\/(\d+)$/))) {
  const pr = m[1] === state.repo ? state.prs[m[2]] : undefined;
  if (!pr) fail("gh: Not Found (HTTP 404)");
  process.stdout.write(JSON.stringify(prJson(Number(m[2]), pr)));
} else if ((m = path.match(/^repos\/([^/]+\/[^/]+)\/issues\/(\d+)$/))) {
  const issue = m[1] === state.repo ? state.issues[m[2]] : undefined;
  if (!issue) fail("gh: Not Found (HTTP 404)");
  process.stdout.write(JSON.stringify({ number: Number(m[2]), title: issue, state: "open", body: "", labels: [], html_url: `https://github.com/${m[1]}/issues/${m[2]}` }));
} else fail(`fake gh: unsupported call ${argv.join(" ")}`);
